# ─────────────────────────────────────────────
# FreshFork — Phase 0 environment
# Copy to `.env.local` and fill in per service.
# ─────────────────────────────────────────────

# ── Supabase (Postgres + Auth + Storage + Realtime)
# From: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Connect, marketplace payments)
# From: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set after creating the Connect webhook endpoint in Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform commission, in basis points (1200 = 12%).
FRESHFORK_PLATFORM_FEE_BPS=1200

# ── Mapbox (geocoding + map tiles)
# From: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# ── Resend (transactional email)
# From: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@freshfork.example

# ── Sentry (error tracking)
# From: https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# ── App
NEXT_PUBLIC_APP_URL=http://localhost:3000
