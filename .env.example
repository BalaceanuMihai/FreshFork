# ─────────────────────────────────────────────
# FreshFork — Phase 0 environment
# Copy to `.env.local` and fill in per service.
# ─────────────────────────────────────────────

# ── Supabase (Postgres + Auth + Storage + Realtime)
# From: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Preferred: the modern publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, still accepted if the publishable key is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Connect, marketplace payments)
# From: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set after creating the Connect webhook endpoint in Stripe. Locally: run
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, it prints one.
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform commission, in basis points (1200 = 12%).
# Seeds a fresh environment and pre-fills the admin settings form. The value
# actually applied to an order lives in the `platform_settings` table, because
# create_order() has to read it server-side — a fee passed in the request
# would be a fee the customer could choose.
FRESHFORK_PLATFORM_FEE_BPS=1200
# FreshFork Plus membership — recurring Price id from Stripe (Product catalog).
STRIPE_PLUS_PRICE_ID=price_...

# ── Mapbox (geocoding + map tiles)
# From: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# ── Resend (transactional email)
# From: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@freshfork.example

# ── Sentry (error tracking)
# From: https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# ── Scheduled maintenance
# Bearer token for POST /api/cron/maintenance, which returns stock from
# abandoned checkouts, deletes orphaned storage objects, and prunes rate-limit
# rows. Generate with: openssl rand -hex 32
# Without it the endpoint refuses every request, and abandoned checkouts will
# only be released by Stripe's own session expiry.
CRON_SECRET=

# ── App
NEXT_PUBLIC_APP_URL=http://localhost:3000
